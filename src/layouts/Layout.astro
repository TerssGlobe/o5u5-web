---
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'OPG O5U5 — svježe sezonsko povrće iz Vrbovca',
  description = 'Obiteljsko poljoprivredno gospodarstvo iz Vrbovca. Svježe sezonsko povrće, uzgojeno s ljubavlju. Okus doma, kvaliteta koju osjetiš.',
} = Astro.props;
---

<!doctype html>
<html lang="hr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Nunito+Sans:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
